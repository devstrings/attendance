# # Alternative backend URL (for production)
# # REACT_APP_API_URL=https://your-production-api.com/api/v1

# # ================================
# # APP CONFIGURATION
# # ================================
# REACT_APP_NAME=Attendance Management System
# REACT_APP_VERSION=1.0.0
# REACT_APP_DESCRIPTION=Complete Attendance & Leave Management Solution

# # ================================
# # ENVIRONMENT
# # ================================
# REACT_APP_ENV=development
# NODE_ENV=development

# # ================================
# # FEATURES FLAGS (Optional)
# # ================================
# REACT_APP_ENABLE_NOTIFICATIONS=true
# REACT_APP_ENABLE_DARK_MODE=true
# REACT_APP_ENABLE_ANALYTICS=false

# # ================================
# # PAGINATION (Optional)
# # ================================
# REACT_APP_DEFAULT_PAGE_SIZE=10
# REACT_APP_MAX_PAGE_SIZE=100

# # ================================
# # DATE FORMAT (Optional)
# # ================================
# REACT_APP_DATE_FORMAT=DD/MM/YYYY
# REACT_APP_TIME_FORMAT=HH:mm:ss

# # ================================
# # FILE UPLOAD (Optional)
# # ================================
# REACT_APP_MAX_FILE_SIZE=5242880
# REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# # ================================
# # SESSION TIMEOUT (in minutes)
# # ================================
# REACT_APP_SESSION_TIMEOUT=60

# # ================================
# # DEBUG MODE
# # ================================
# REACT_APP_DEBUG=true
# REACT_APP_SHOW_LOGS=true




# ================================
# PORT CONFIGURATION
# ================================
PORT=3000

# ================================
# BACKEND API CONFIGURATION
# ================================
REACT_APP_API_URL=http://localhost:5000/api/v1

# ================================
# APP CONFIGURATION
# ================================
REACT_APP_NAME=Attendance System - Employee & Manager Portal
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Employee & Manager Attendance Management

# ================================
# ENVIRONMENT
# ================================
REACT_APP_ENV=development
NODE_ENV=development

# ================================
# FEATURES FLAGS
# ================================
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_ANALYTICS=false

# ================================
# PAGINATION
# ================================
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100

# ================================
# DATE FORMAT
# ================================
REACT_APP_DATE_FORMAT=DD/MM/YYYY
REACT_APP_TIME_FORMAT=HH:mm:ss

# ================================
# FILE UPLOAD
# ================================
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ================================
# SESSION TIMEOUT (in minutes)
# ================================
REACT_APP_SESSION_TIMEOUT=60

# ================================
# DEBUG MODE
# ================================
REACT_APP_DEBUG=true
REACT_APP_SHOW_LOGS=true