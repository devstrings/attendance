PORT=3001

REACT_APP_API_URL=http://localhost:5000/api/v1

REACT_APP_NAME=Attendance System - Admin Portal
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Admin Dashboard for Attendance Management

REACT_APP_ENV=development
NODE_ENV=development

REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_ANALYTICS=false

REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100

REACT_APP_DATE_FORMAT=DD/MM/YYYY
REACT_APP_TIME_FORMAT=HH:mm:ss

REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

REACT_APP_SESSION_TIMEOUT=60

REACT_APP_DEBUG=true
REACT_APP_SHOW_LOGS=true