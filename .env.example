# ================================
# SHARED / INFRA
# ================================
MONGO_PORT=27017
MONGO_DB=attendance-system
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

# ================================
# BACKEND
# ================================
BACKEND_PORT=5000
BACKEND_NODE_ENV=development
MONGO_URI=mongodb://admin:admin123@mongodb:27017/attendance-system?authSource=admin

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Attendance System
EMAIL_FROM=your-email@gmail.com

FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
API_PREFIX=/api/v1

MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
GRACE_PERIOD_MINUTES=15
STANDARD_WORK_HOURS=8
OVERTIME_RATE=1.5
ANNUAL_LEAVE_ENTITLEMENT=21
SICK_LEAVE_ENTITLEMENT=10
CASUAL_LEAVE_ENTITLEMENT=10
EMERGENCY_LEAVE_ENTITLEMENT=5
MINIMUM_SALARY=10000
CURRENCY=PKR

# ================================
# EMPLOYEE/MANAGER FRONTEND
# ================================
FRONTEND_PORT=3000
FRONTEND_NODE_ENV=development
FRONTEND_REACT_APP_API_URL=http://localhost:5000/api/v1
FRONTEND_REACT_APP_NAME=Attendance System - Employee & Manager Portal
FRONTEND_REACT_APP_VERSION=1.0.0
FRONTEND_REACT_APP_DESCRIPTION=Employee & Manager Attendance Management
FRONTEND_REACT_APP_ENV=development

# ================================
# ADMIN FRONTEND
# ================================
ADMIN_FRONTEND_PORT=3001
ADMIN_FRONTEND_NODE_ENV=development
ADMIN_REACT_APP_API_URL=http://localhost:5000/api/v1
ADMIN_REACT_APP_NAME=Attendance System - Admin Portal
ADMIN_REACT_APP_VERSION=1.0.0
ADMIN_REACT_APP_DESCRIPTION=Admin Dashboard for Attendance Management
ADMIN_REACT_APP_ENV=development
